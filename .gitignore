# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo
coverage/

# Logs
*.log
logs/

# Environment & secrets
.env
.env.*
!.env.example
*.secret
*.pem
*.key
*.cert
credentials.json
token.json

# Local MCP companion config — holds machine paths + a bridge token. Ship the template
# (.mcp.json.example), never the live file.
.mcp.json

# Local data (Postgres lives in a Docker volume; the Markdown mirror is a separate repo)
data/

# Backups & mirror — these contain the full personal brain; never commit them
backups/
*-backups/
*-mirror/
*.sql
*.sql.gz
*.dump
# …but migrations are source code, not data — never brain dumps.
!packages/*/migrations/*.sql

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# recall benchmark scorecards (generated)
packages/core/src/eval/results/

# LOCOMO benchmark data (fetched via download.sh) + generated scorecards — never committed
packages/core/src/eval/locomo/data/
packages/core/src/eval/locomo/results/

# Personal finance harness — kept on the local-only branch local/finance, never on the public
# tree. Belt-and-suspenders so a stray `git add -A` can't re-track it. (The voice stack is
# public + customizable; only finance stays private.)
/finance/
/docs/finance/
.claude/
