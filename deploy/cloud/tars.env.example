# Tars production env — lives at /etc/tars/tars.env on the server (root-only, 0600).
# NEVER commit the real file. bootstrap.sh generates the secrets on the box so they
# never touch git or any transcript. This is only the shape.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=tars
POSTGRES_DB=tars
# Generated on the server: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_PASSWORD=__generated_on_server__

# --- Embeddings (local, on-box; nothing leaves the machine) -----------------
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Embed any observations missing a vector on boot (set 1 for the first run after import).
TARS_BACKFILL_ON_BOOT=0

# --- Public OAuth listener (fronted by Tailscale Serve, tailnet-only) -------
PUBLIC_PORT=8788
# Your node's MagicDNS name. Fill in after `tailscale up` (tailscale status --json | .Self.DNSName)
PUBLIC_BASE_URL=https://tars.your-tailnet.ts.net

# --- Backups: restic -> Backblaze B2 (encrypted at source) ------------------
# Lives in a SEPARATE root-only file (/etc/tars/backup.env, 0600) — see backup/restic-backup.sh.
# The hourly run only ADDS snapshots, so this key should be created WITHOUT delete rights
# (Backblaze: uncheck deleteFiles) and the bucket should have Object Lock enabled — then a
# box compromise cannot wipe your backup history. Prune (deletes) is a separate, occasional
# `restic-backup.sh --prune` run with a delete-capable key.
# B2_ACCOUNT_ID=__b2_keyID__                 # append-only key (no deleteFiles)
# B2_ACCOUNT_KEY=__b2_applicationKey__
# RESTIC_REPOSITORY=b2:tars-brain-backups:tars
# RESTIC_PASSWORD=__generated_on_server__   # WITHOUT THIS YOU CANNOT RESTORE. Store a copy offline.
